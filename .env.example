# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Firebase Service Account (for Vercel/production deployment)
# Paste the entire contents of firebase-service-account.json as a single-line JSON string
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret
