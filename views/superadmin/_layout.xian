<!-- Super Admin Sidebar Layout Partial -->
<aside id="sa-sidebar" class="fixed top-0 left-0 h-full w-64 bg-gradient-to-b from-gray-900 via-gray-900 to-emerald-950 shadow-2xl z-40 flex flex-col transition-transform duration-300">

    <!-- Brand -->
    <div class="flex items-center gap-3 px-5 py-5 border-b border-white border-opacity-10">
        <img src="/images/logo/minsu-logo.png" alt="MinSU" class="w-10 h-10 object-contain flex-shrink-0">
        <div class="min-w-0">
            <p class="text-white font-black text-sm leading-tight">MinSU DocuReg</p>
            <p class="text-emerald-400 text-xs">Super Admin</p>
        </div>
    </div>

    <!-- User info -->
    <div class="flex items-center gap-3 px-5 py-4 border-b border-white border-opacity-10">
        <div class="w-9 h-9 rounded-full bg-yellow-500 flex items-center justify-center text-white font-black text-sm flex-shrink-0">
            {{user.name.[0]}}
        </div>
        <div class="min-w-0">
            <p class="text-white font-bold text-sm truncate">{{user.name}}</p>
            <div class="inline-flex items-center gap-1 bg-yellow-500 bg-opacity-20 text-yellow-300 text-xs font-bold px-2 py-0.5 rounded-full">
                <i class="fas fa-crown text-xs"></i> Super Admin
            </div>
        </div>
    </div>

    <!-- Nav links -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
        <p class="text-gray-500 text-xs font-bold uppercase tracking-widest px-3 mb-2">Overview</p>

        <a href="/superadmin/dashboard" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-emerald-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-tachometer-alt text-emerald-400 text-xs"></i>
            </div>
            Dashboard
        </a>

        <a href="/superadmin/campuses" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-teal-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-university text-teal-400 text-xs"></i>
            </div>
            Campuses
        </a>

        <p class="text-gray-500 text-xs font-bold uppercase tracking-widest px-3 mt-4 mb-2">Management</p>

        <a href="/superadmin/users" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-blue-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-users text-blue-400 text-xs"></i>
            </div>
            All Users
        </a>

        <a href="/superadmin/requests" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-amber-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-file-alt text-amber-400 text-xs"></i>
            </div>
            All Requests
        </a>

        <p class="text-gray-500 text-xs font-bold uppercase tracking-widest px-3 mt-4 mb-2">Reports</p>

        <a href="/superadmin/analytics" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-purple-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-chart-line text-purple-400 text-xs"></i>
            </div>
            Analytics
        </a>

        <a href="/registrar/report" class="sa-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm group">
            <div class="w-8 h-8 rounded-lg bg-orange-600 bg-opacity-30 flex items-center justify-center group-hover:bg-opacity-50 transition flex-shrink-0">
                <i class="fas fa-chart-bar text-orange-400 text-xs"></i>
            </div>
            Reports
        </a>
    </nav>

    <!-- Notification bell + Logout at bottom -->
    <div class="px-3 py-4 border-t border-white border-opacity-10 space-y-1">
        <button onclick="toggleNotifPanel()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-300 hover:text-white hover:bg-white hover:bg-opacity-10 transition font-semibold text-sm">
            <div class="w-8 h-8 rounded-lg bg-gray-700 flex items-center justify-center flex-shrink-0 relative">
                <i class="fas fa-bell text-gray-300 text-xs"></i>
                <span id="notif-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-xs font-black rounded-full flex items-center justify-center leading-none">0</span>
            </div>
            Notifications
        </button>
        <a href="/logout" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-red-400 hover:text-white hover:bg-red-600 hover:bg-opacity-80 transition font-semibold text-sm">
            <div class="w-8 h-8 rounded-lg bg-red-600 bg-opacity-20 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-sign-out-alt text-red-400 text-xs"></i>
            </div>
            Logout
        </a>
    </div>
</aside>

<!-- Notification panel (floats over content) -->
<div id="notif-panel" class="hidden fixed left-64 bottom-20 w-80 bg-white rounded-2xl shadow-2xl border border-gray-100 z-50 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 bg-gradient-to-r from-emerald-600 to-teal-600">
        <span class="text-white font-black text-sm">Notifications</span>
        <button onclick="markAllRead()" class="text-emerald-100 hover:text-white text-xs font-semibold transition">Mark all read</button>
    </div>
    <div id="notif-list" class="max-h-80 overflow-y-auto divide-y divide-gray-100">
        <p class="text-gray-400 text-sm text-center py-8">No notifications</p>
    </div>
</div>

<!-- Mobile sidebar toggle -->
<button id="sa-toggle" onclick="document.getElementById('sa-sidebar').classList.toggle('-translate-x-full')"
    class="fixed top-4 left-4 z-50 md:hidden bg-gray-900 text-white p-2 rounded-lg shadow-lg">
    <i class="fas fa-bars"></i>
</button>

<script>
    // Highlight active nav link
    const currentPath = window.location.pathname;
    document.querySelectorAll('.sa-nav-link').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
            link.classList.add('bg-white', 'bg-opacity-15', 'text-white');
            link.classList.remove('text-gray-300');
        }
    });
</script>
