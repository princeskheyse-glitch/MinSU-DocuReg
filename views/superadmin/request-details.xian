<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
    <title>Request Details — MinSU DocuReg</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes fadeInUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        .anim-up { animation:fadeInUp .5s ease-out both; }
        .d1{animation-delay:.05s} .d2{animation-delay:.1s}
        .info-row { transition:background .15s; }
        .info-row:hover { background:#f0fdf4; }
    </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-slate-50 min-h-screen flex flex-col">
    {{>navbar}}
    <main class="flex-1 max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 pb-16">

        <!-- Breadcrumb -->
        <div class="mb-6 flex items-center gap-2 text-sm text-gray-500">
            <a href="/superadmin/requests" class="hover:text-emerald-600 font-semibold transition flex items-center gap-1">
                <i class="fas fa-arrow-left text-xs"></i> Back to All Requests
            </a>
            <span>/</span>
            <span class="text-gray-700 font-semibold">Request Details</span>
        </div>

        <!-- Header -->
        <div class="anim-up bg-gradient-to-r from-emerald-700 to-teal-700 rounded-2xl shadow-xl px-8 py-7 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="min-w-0">
                <div class="inline-flex items-center gap-2 bg-yellow-400 bg-opacity-20 text-yellow-200 text-xs font-bold px-3 py-1 rounded-full mb-2">
                    <i class="fas fa-crown"></i> SUPER ADMIN — READ ONLY
                </div>
                <p class="text-emerald-200 text-xs font-bold uppercase tracking-widest mb-1">Document Request</p>
                <h1 class="text-white text-2xl font-black truncate">{{formatDocType request.documentType}}</h1>
                <p class="text-emerald-300 text-xs mt-1 font-mono">ID: {{request.id}}</p>
                {{#if request.campus}}
                <span class="inline-flex items-center gap-1 mt-2 px-3 py-1 rounded-full text-xs font-bold bg-white bg-opacity-20 text-white">
                    <i class="fas fa-university"></i> {{request.campus.name}}
                </span>
                {{/if}}
            </div>
            <div class="flex-shrink-0">
                {{#switch request.status}}
                    {{#case 'pending'}}<span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-amber-100 text-amber-800"><i class="fas fa-hourglass-start"></i>Pending</span>{{/case}}
                    {{#case 'processing'}}<span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-blue-100 text-blue-800"><i class="fas fa-cog"></i>Processing</span>{{/case}}
                    {{#case 'ready'}}<span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-emerald-100 text-emerald-800"><i class="fas fa-check-circle"></i>Ready</span>{{/case}}
                    {{#case 'completed'}}<span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-teal-100 text-teal-800"><i class="fas fa-check-double"></i>Completed</span>{{/case}}
                    {{#case 'rejected'}}<span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-red-100 text-red-800"><i class="fas fa-times-circle"></i>Rejected</span>{{/case}}
                {{/switch}}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Student Info -->
            <div class="anim-up d1 bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-600 to-teal-600 px-6 py-4">
                    <h2 class="text-white font-black text-base flex items-center gap-2"><i class="fas fa-user-graduate"></i> Student</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-black text-lg flex-shrink-0">{{request.student.name.[0]}}</div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Full Name</p>
                            <p class="text-gray-900 font-bold">{{request.student.name}}</p>
                        </div>
                    </div>
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0"><i class="fas fa-id-badge"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Student Number</p>
                            <p class="text-gray-900 font-bold font-mono">{{request.student.studentId}}</p>
                        </div>
                    </div>
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 flex-shrink-0"><i class="fas fa-envelope"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Email</p>
                            <p class="text-gray-900 font-semibold text-sm">{{request.student.email}}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Request Info -->
            <div class="anim-up d2 bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-4">
                    <h2 class="text-white font-black text-base flex items-center gap-2"><i class="fas fa-file-alt"></i> Request Info</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0"><i class="fas fa-file-contract"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Document Type</p>
                            <p class="text-gray-900 font-bold">{{formatDocType request.documentType}}</p>
                        </div>
                    </div>
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0"><i class="fas fa-copy"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Quantity</p>
                            <p class="text-gray-900 font-bold">{{request.quantity}} {{#if_eq request.quantity 1}}Copy{{else}}Copies{{/if_eq}}</p>
                        </div>
                    </div>
                    <div class="info-row flex items-start gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-600 flex-shrink-0 mt-0.5"><i class="fas fa-pen"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Purpose</p>
                            <p class="text-gray-900 font-semibold">{{request.purpose}}</p>
                        </div>
                    </div>
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 flex-shrink-0"><i class="fas fa-calendar-alt"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Date Submitted</p>
                            <p class="text-gray-900 font-bold">{{formatDate request.createdAt}}</p>
                        </div>
                    </div>
                    {{#if request.registrar}}
                    <div class="info-row flex items-center gap-4 px-6 py-4">
                        <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-orange-600 flex-shrink-0"><i class="fas fa-user-tie"></i></div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Processed By</p>
                            <p class="text-gray-900 font-bold">{{request.registrar.name}}</p>
                        </div>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>

        <!-- Notes / Rejection -->
        {{#if request.notes}}
        <div class="anim-up mt-4 bg-orange-50 border border-orange-200 rounded-2xl px-6 py-5">
            <p class="text-orange-700 text-xs font-bold uppercase tracking-wide mb-2 flex items-center gap-2"><i class="fas fa-sticky-note"></i> Registrar Notes</p>
            <p class="text-gray-800">{{request.notes}}</p>
        </div>
        {{/if}}
        {{#if request.rejectionReason}}
        <div class="anim-up mt-4 bg-red-50 border border-red-200 rounded-2xl px-6 py-5">
            <p class="text-red-700 text-xs font-bold uppercase tracking-wide mb-2 flex items-center gap-2"><i class="fas fa-exclamation-triangle"></i> Rejection Reason</p>
            <p class="text-gray-800">{{request.rejectionReason}}</p>
        </div>
        {{/if}}

        <!-- Appointments -->
        {{#if appointments.length}}
        <div class="anim-up mt-4 bg-white rounded-2xl shadow-md overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                <h2 class="text-white font-black text-base flex items-center gap-2"><i class="fas fa-calendar-check"></i> Appointments</h2>
            </div>
            <div class="divide-y divide-gray-100">
                {{#each appointments}}
                <div class="info-row flex items-center justify-between px-6 py-4 gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0"><i class="fas fa-clock text-sm"></i></div>
                        <div>
                            <p class="text-gray-900 font-bold text-sm">{{formatDate this.appointmentDate}} at {{this.appointmentTime}}</p>
                            {{#if this.notes}}<p class="text-gray-500 text-xs mt-0.5">{{this.notes}}</p>{{/if}}
                        </div>
                    </div>
                    {{#switch this.status}}
                        {{#case 'scheduled'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700 whitespace-nowrap">Scheduled</span>{{/case}}
                        {{#case 'completed'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 whitespace-nowrap">Completed</span>{{/case}}
                        {{#case 'missed'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700 whitespace-nowrap">Missed</span>{{/case}}
                        {{#case 'cancelled'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 whitespace-nowrap">Cancelled</span>{{/case}}
                    {{/switch}}
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}

        <!-- Info note -->
        <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-2xl px-5 py-4 flex items-start gap-3">
            <i class="fas fa-info-circle text-yellow-500 mt-0.5 flex-shrink-0"></i>
            <p class="text-yellow-800 text-sm">As Super Admin, you have read-only access to this request. To process or update it, the campus registrar or admin must handle it through their portal.</p>
        </div>

    </main>
    {{>footer}}
</body>
</html>
