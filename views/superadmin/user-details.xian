<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
    <title>User Details — MinSU DocuReg</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes fadeInUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        .anim-up { animation:fadeInUp .5s ease-out both; }
        .d1{animation-delay:.05s} .d2{animation-delay:.1s} .d3{animation-delay:.15s}
        .info-row { transition:background .15s; }
        .info-row:hover { background:#f0fdf4; }
        .tr-hover { transition:background .15s,transform .15s; }
        .tr-hover:hover { background:#f0fdf4; }
    </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-slate-50 min-h-screen flex flex-col">
    {{>navbar}}
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 pb-16">

        <!-- Breadcrumb -->
        <div class="mb-6 flex items-center gap-2 text-sm text-gray-500">
            <a href="/superadmin/users" class="hover:text-emerald-600 font-semibold transition flex items-center gap-1">
                <i class="fas fa-arrow-left text-xs"></i> Back to All Users
            </a>
            <span>/</span>
            <span class="text-gray-700 font-semibold">{{targetUser.name}}</span>
        </div>

        <!-- Header Card -->
        <div class="anim-up bg-gradient-to-r from-emerald-700 to-teal-700 rounded-2xl shadow-xl px-8 py-7 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-white bg-opacity-20 flex items-center justify-center text-white font-black text-3xl flex-shrink-0">
                    {{targetUser.name.[0]}}
                </div>
                <div>
                    <div class="inline-flex items-center gap-2 bg-yellow-400 bg-opacity-20 text-yellow-200 text-xs font-bold px-3 py-1 rounded-full mb-2">
                        <i class="fas fa-crown"></i> SUPER ADMIN VIEW
                    </div>
                    <h1 class="text-white text-2xl font-black">{{targetUser.name}}</h1>
                    <p class="text-emerald-200 text-sm">{{targetUser.email}}</p>
                </div>
            </div>
            <div class="flex flex-col items-end gap-2">
                {{#switch targetUser.role}}
                    {{#case 'student'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-blue-100 text-blue-800"><i class="fas fa-graduation-cap mr-1"></i>Student</span>{{/case}}
                    {{#case 'registrar'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-indigo-100 text-indigo-800"><i class="fas fa-briefcase mr-1"></i>Registrar</span>{{/case}}
                    {{#case 'admin'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-orange-100 text-orange-800"><i class="fas fa-shield-alt mr-1"></i>Campus Admin</span>{{/case}}
                    {{#case 'superadmin'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-yellow-100 text-yellow-800"><i class="fas fa-crown mr-1"></i>Super Admin</span>{{/case}}
                {{/switch}}
                {{#switch targetUser.status}}
                    {{#case 'active'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-emerald-100 text-emerald-800"><i class="fas fa-check-circle mr-1"></i>Active</span>{{/case}}
                    {{#case 'inactive'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-gray-100 text-gray-700"><i class="fas fa-minus-circle mr-1"></i>Inactive</span>{{/case}}
                    {{#case 'suspended'}}<span class="px-3 py-1.5 rounded-full text-sm font-bold bg-red-100 text-red-800"><i class="fas fa-ban mr-1"></i>Suspended</span>{{/case}}
                {{/switch}}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Left: User Info -->
            <div class="lg:col-span-2 space-y-5">

                <!-- Account Details -->
                <div class="anim-up d1 bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-4">
                        <h2 class="text-white font-black text-base flex items-center gap-2"><i class="fas fa-user"></i> Account Details</h2>
                    </div>
                    <div class="divide-y divide-gray-100">
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0"><i class="fas fa-envelope"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">Email</p>
                                <p class="text-gray-900 font-semibold">{{targetUser.email}}</p>
                            </div>
                        </div>
                        {{#if targetUser.studentId}}
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0"><i class="fas fa-id-badge"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">Student ID</p>
                                <p class="text-gray-900 font-bold font-mono">{{targetUser.studentId}}</p>
                            </div>
                        </div>
                        {{/if}}
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 flex-shrink-0"><i class="fas fa-shield-alt"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">Role</p>
                                <p class="text-gray-900 font-bold capitalize">{{targetUser.role}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0"><i class="fas fa-university"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">Campus</p>
                                {{#if targetUser.campus}}
                                <p class="text-gray-900 font-bold">{{targetUser.campus.name}}</p>
                                {{else}}
                                <p class="text-yellow-600 font-bold">Global (No Campus)</p>
                                {{/if}}
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 flex-shrink-0"><i class="fas fa-calendar-alt"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">Registered</p>
                                <p class="text-gray-900 font-bold">{{formatDate targetUser.createdAt}}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Document Requests (students only) -->
                {{#if userRequests.length}}
                <div class="anim-up d2 bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-700 to-teal-700 px-6 py-4">
                        <h2 class="text-white font-black text-base flex items-center gap-2"><i class="fas fa-file-alt"></i> Document Requests ({{userRequests.length}})</h2>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Document</th>
                                    <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
                                    <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Date</th>
                                    <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                {{#each userRequests}}
                                <tr class="tr-hover">
                                    <td class="px-5 py-4 text-sm font-semibold text-gray-800">{{formatDocType this.documentType}}</td>
                                    <td class="px-5 py-4">
                                        {{#switch this.status}}
                                            {{#case 'pending'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">Pending</span>{{/case}}
                                            {{#case 'processing'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">Processing</span>{{/case}}
                                            {{#case 'ready'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">Ready</span>{{/case}}
                                            {{#case 'completed'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-teal-100 text-teal-700">Completed</span>{{/case}}
                                            {{#case 'rejected'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">Rejected</span>{{/case}}
                                        {{/switch}}
                                    </td>
                                    <td class="px-5 py-4 text-xs text-gray-400">{{formatDate this.createdAt}}</td>
                                    <td class="px-5 py-4">
                                        <a href="/superadmin/requests/{{this.id}}" class="text-emerald-600 hover:text-emerald-800 font-bold text-xs transition inline-flex items-center gap-1">
                                            View <i class="fas fa-arrow-right text-xs"></i>
                                        </a>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- Right: Actions -->
            <div class="space-y-4">

                <!-- Change Role -->
                <div class="anim-up d1 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-shield-alt text-violet-500"></i> Change Role
                    </h3>
                    <form method="POST" action="/superadmin/users/{{targetUser.id}}/role" class="space-y-3">
                        <select name="role" required class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500 font-medium">
                            <option value="">Select role...</option>
                            <option value="student" {{#if_eq targetUser.role 'student'}}selected{{/if_eq}}>Student</option>
                            <option value="registrar" {{#if_eq targetUser.role 'registrar'}}selected{{/if_eq}}>Registrar</option>
                            <option value="admin" {{#if_eq targetUser.role 'admin'}}selected{{/if_eq}}>Campus Admin</option>
                            <option value="superadmin" {{#if_eq targetUser.role 'superadmin'}}selected{{/if_eq}}>Super Admin</option>
                        </select>
                        <button type="submit" class="w-full bg-violet-600 hover:bg-violet-700 text-white font-bold py-2.5 rounded-xl text-sm transition">
                            <i class="fas fa-check mr-1"></i> Update Role
                        </button>
                    </form>
                </div>

                <!-- Assign Campus -->
                <div class="anim-up d2 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-university text-emerald-500"></i> Assign Campus
                    </h3>
                    <form method="POST" action="/superadmin/users/{{targetUser.id}}/campus" class="space-y-3">
                        <select name="campusId" class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500 font-medium">
                            <option value="">No Campus (Global)</option>
                            {{#each campuses}}
                            <option value="{{this.id}}" {{#if_eq ../targetUser.campusId this.id}}selected{{/if_eq}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-sm transition">
                            <i class="fas fa-check mr-1"></i> Assign Campus
                        </button>
                    </form>
                </div>

                <!-- Change Status -->
                <div class="anim-up d2 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-toggle-on text-blue-500"></i> Change Status
                    </h3>
                    <form method="POST" action="/superadmin/users/{{targetUser.id}}/status" class="space-y-3">
                        <select name="status" required class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500 font-medium">
                            <option value="active" {{#if_eq targetUser.status 'active'}}selected{{/if_eq}}>Active</option>
                            <option value="inactive" {{#if_eq targetUser.status 'inactive'}}selected{{/if_eq}}>Inactive</option>
                            <option value="suspended" {{#if_eq targetUser.status 'suspended'}}selected{{/if_eq}}>Suspended</option>
                        </select>
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl text-sm transition">
                            <i class="fas fa-check mr-1"></i> Update Status
                        </button>
                    </form>
                </div>

                <!-- Reset Password -->
                <div class="anim-up d3 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-key text-orange-500"></i> Reset Password
                    </h3>
                    <form method="POST" action="/superadmin/users/{{targetUser.id}}/reset-password" class="space-y-3">
                        <input type="password" name="newPassword" required placeholder="New password" minlength="6"
                            class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-400">
                        <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 rounded-xl text-sm transition">
                            <i class="fas fa-key mr-1"></i> Reset Password
                        </button>
                    </form>
                </div>

                <!-- Delete -->
                {{#unless_eq targetUser.id user.id}}
                <div class="anim-up d3 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-trash text-red-500"></i> Delete Account
                    </h3>
                    <p class="text-gray-500 text-xs mb-3">This permanently deletes the user. This cannot be undone.</p>
                    <form method="POST" action="/superadmin/users/{{targetUser.id}}/delete">
                        <button type="submit"
                            onclick="return confirm('Permanently delete {{targetUser.name}}? This cannot be undone.')"
                            class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-2.5 rounded-xl text-sm transition">
                            <i class="fas fa-trash mr-1"></i> Delete User
                        </button>
                    </form>
                </div>
                {{/unless_eq}}
            </div>
        </div>
    </main>
    {{>footer}}
</body>
</html>
