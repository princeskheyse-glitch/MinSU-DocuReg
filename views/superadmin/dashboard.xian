<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
    <title>Super Admin Dashboard — MinSU DocuReg</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes fadeInUp   { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        @keyframes fadeInDown { from{opacity:0;transform:translateY(-20px)} to{opacity:1;transform:translateY(0)} }
        .anim-up   { animation:fadeInUp .5s ease-out both; }
        .anim-down { animation:fadeInDown .5s ease-out both; }
        .d1{animation-delay:.05s} .d2{animation-delay:.1s} .d3{animation-delay:.15s}
        .d4{animation-delay:.2s}  .d5{animation-delay:.25s}
        .stat-card { transition:transform .25s,box-shadow .25s; }
        .stat-card:hover { transform:translateY(-4px); box-shadow:0 16px 32px rgba(0,0,0,.1); }
        .tr-hover { transition:background .15s,transform .15s; }
        .tr-hover:hover { background:#f0fdf4; }
    </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-slate-50 min-h-screen flex flex-col">
    {{>navbar}}
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 pb-16">

        <!-- Greeting -->
        <div class="anim-down mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <div class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full mb-2">
                    <i class="fas fa-crown"></i> SUPER ADMINISTRATOR — GLOBAL ACCESS
                </div>
                <h1 class="text-3xl font-black text-gray-800">System Overview</h1>
                <p class="text-gray-500 text-sm mt-1">All 3 campuses — Mindoro State University</p>
            </div>
            <div class="flex gap-2 flex-wrap">
                <a href="/superadmin/campuses" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl text-sm shadow transition hover:scale-105">
                    <i class="fas fa-university"></i> Campuses
                </a>
                <a href="/superadmin/users" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl text-sm shadow-sm transition">
                    <i class="fas fa-users text-blue-500"></i> All Users
                </a>
                <a href="/superadmin/analytics" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl text-sm shadow-sm transition">
                    <i class="fas fa-chart-line text-purple-500"></i> Analytics
                </a>
            </div>
        </div>

        <!-- Global Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="anim-up d1 stat-card bg-gradient-to-br from-emerald-600 to-teal-600 rounded-2xl p-6 text-white shadow-lg col-span-2 sm:col-span-1">
                <p class="text-emerald-100 text-xs font-bold uppercase tracking-wide mb-1">Total Requests</p>
                <p class="text-5xl font-black">{{stats.totalRequests}}</p>
                <p class="text-emerald-200 text-xs mt-2">Across all campuses</p>
            </div>
            <div class="anim-up d2 stat-card bg-white rounded-2xl p-6 shadow-md border-t-4 border-amber-400">
                <p class="text-amber-600 text-xs font-bold uppercase tracking-wide mb-1">Pending</p>
                <p class="text-4xl font-black text-amber-500">{{stats.pendingRequests}}</p>
                <p class="text-gray-400 text-xs mt-1">Awaiting review</p>
            </div>
            <div class="anim-up d3 stat-card bg-white rounded-2xl p-6 shadow-md border-t-4 border-violet-400">
                <p class="text-violet-600 text-xs font-bold uppercase tracking-wide mb-1">Total Users</p>
                <p class="text-4xl font-black text-violet-600">{{stats.totalUsers}}</p>
                <p class="text-gray-400 text-xs mt-1">{{stats.totalStudents}} students</p>
            </div>
            <div class="anim-up d4 stat-card bg-white rounded-2xl p-6 shadow-md border-t-4 border-teal-400">
                <p class="text-teal-600 text-xs font-bold uppercase tracking-wide mb-1">Completed</p>
                <p class="text-4xl font-black text-teal-500">{{stats.completedRequests}}</p>
                <p class="text-gray-400 text-xs mt-1">Fulfilled</p>
            </div>
        </div>

        <!-- Per-Campus Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
            {{#each campusStats}}
            <div class="anim-up d2 stat-card bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">
                <div class="bg-gradient-to-r from-emerald-700 to-teal-700 px-5 py-4 flex items-center justify-between">
                    <div>
                        <p class="text-emerald-200 text-xs font-bold uppercase tracking-widest">{{this.campus.code}}</p>
                        <h3 class="text-white font-black text-sm">{{this.campus.name}}</h3>
                    </div>
                    <div class="w-10 h-10 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-university text-white"></i>
                    </div>
                </div>
                <div class="p-5 grid grid-cols-3 gap-3 text-center">
                    <div>
                        <p class="text-2xl font-black text-gray-800">{{this.users}}</p>
                        <p class="text-xs text-gray-400 font-semibold">Users</p>
                    </div>
                    <div>
                        <p class="text-2xl font-black text-amber-500">{{this.pending}}</p>
                        <p class="text-xs text-gray-400 font-semibold">Pending</p>
                    </div>
                    <div>
                        <p class="text-2xl font-black text-teal-500">{{this.completed}}</p>
                        <p class="text-xs text-gray-400 font-semibold">Done</p>
                    </div>
                </div>
                <div class="px-5 pb-4">
                    <a href="/superadmin/requests?campus={{this.campus.id}}" class="w-full flex items-center justify-center gap-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold py-2 rounded-xl text-sm transition">
                        <i class="fas fa-tasks text-xs"></i> View Requests
                    </a>
                </div>
            </div>
            {{/each}}
        </div>

        <!-- Main content: requests + sidebar -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

            <!-- Recent Requests -->
            <div class="lg:col-span-2 anim-up d3 bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 py-5 flex items-center justify-between">
                    <h2 class="text-white font-black text-base flex items-center gap-2">
                        <i class="fas fa-file-invoice text-emerald-400"></i> Recent Requests — All Campuses
                    </h2>
                    <a href="/superadmin/requests" class="text-gray-400 hover:text-white text-xs font-semibold transition">View all →</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Student</th>
                                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Campus</th>
                                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Document</th>
                                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
                                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {{#if recentRequests.length}}
                            {{#each recentRequests}}
                            <tr class="tr-hover">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-black text-xs flex-shrink-0">{{this.student.name.[0]}}</div>
                                        <div>
                                            <p class="text-sm font-semibold text-gray-800">{{this.student.name}}</p>
                                            <p class="text-xs text-gray-400 font-mono">{{this.student.studentId}}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
                                        {{this.campus.code}}
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-sm text-gray-600">{{formatDocType this.documentType}}</td>
                                <td class="px-5 py-4">
                                    {{#switch this.status}}
                                        {{#case 'pending'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">Pending</span>{{/case}}
                                        {{#case 'processing'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">Processing</span>{{/case}}
                                        {{#case 'ready'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">Ready</span>{{/case}}
                                        {{#case 'completed'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-teal-100 text-teal-700">Completed</span>{{/case}}
                                        {{#case 'rejected'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">Rejected</span>{{/case}}
                                    {{/switch}}
                                </td>
                                <td class="px-5 py-4">
                                    <a href="/superadmin/requests/{{this.id}}" class="text-emerald-600 hover:text-emerald-800 font-bold text-xs transition inline-flex items-center gap-1">View <i class="fas fa-arrow-right text-xs"></i></a>
                                </td>
                            </tr>
                            {{/each}}
                            {{else}}
                            <tr><td colspan="5" class="px-5 py-10 text-center text-gray-400 text-sm">No requests yet</td></tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-4">
                <!-- Quick Actions -->
                <div class="anim-up d2 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-bolt text-amber-500"></i> Super Admin Actions
                    </h3>
                    <div class="space-y-2">
                        <a href="/superadmin/campuses" class="flex items-center gap-3 p-3 rounded-xl hover:bg-emerald-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center group-hover:bg-emerald-200 transition flex-shrink-0">
                                <i class="fas fa-university text-emerald-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-800">Manage Campuses</p>
                                <p class="text-xs text-gray-400">View all 3 campuses</p>
                            </div>
                            <i class="fas fa-chevron-right text-gray-300 text-xs ml-auto"></i>
                        </a>
                        <a href="/superadmin/requests" class="flex items-center gap-3 p-3 rounded-xl hover:bg-amber-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center group-hover:bg-amber-200 transition flex-shrink-0">
                                <i class="fas fa-tasks text-amber-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-800">All Requests</p>
                                <p class="text-xs text-gray-400">{{stats.pendingRequests}} pending</p>
                            </div>
                            <i class="fas fa-chevron-right text-gray-300 text-xs ml-auto"></i>
                        </a>
                        <a href="/superadmin/analytics" class="flex items-center gap-3 p-3 rounded-xl hover:bg-purple-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-purple-100 flex items-center justify-center group-hover:bg-purple-200 transition flex-shrink-0">
                                <i class="fas fa-chart-line text-purple-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-800">Global Analytics</p>
                                <p class="text-xs text-gray-400">Cross-campus reports</p>
                            </div>
                            <i class="fas fa-chevron-right text-gray-300 text-xs ml-auto"></i>
                        </a>
                    </div>
                </div>

                <!-- System Health -->
                <div class="anim-up d3 bg-white rounded-2xl shadow-md p-5">
                    <h3 class="text-gray-700 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-heartbeat text-red-500"></i> Global Health
                    </h3>
                    <div class="space-y-2.5 text-sm">
                        <div class="flex justify-between"><span class="text-gray-500 flex items-center gap-2"><i class="fas fa-circle text-emerald-400 text-xs"></i>Active Users</span><span class="font-bold text-emerald-600">{{stats.activeUsers}}</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 flex items-center gap-2"><i class="fas fa-circle text-red-400 text-xs"></i>Suspended</span><span class="font-bold text-red-500">{{stats.suspendedUsers}}</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 flex items-center gap-2"><i class="fas fa-circle text-blue-400 text-xs"></i>Registrars</span><span class="font-bold text-blue-600">{{stats.totalRegistrars}}</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 flex items-center gap-2"><i class="fas fa-circle text-amber-400 text-xs"></i>Scheduled Appts</span><span class="font-bold text-amber-600">{{stats.scheduledAppointments}}</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Users -->
        <div class="anim-up d5 bg-white rounded-2xl shadow-md overflow-hidden">
            <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 py-5 flex items-center justify-between">
                <h2 class="text-white font-black text-base flex items-center gap-2">
                    <i class="fas fa-users text-emerald-400"></i> Recently Registered Users
                </h2>
                <a href="/superadmin/users" class="text-gray-400 hover:text-white text-xs font-semibold transition">View all →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Name</th>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Email</th>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Campus</th>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Role</th>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {{#each recentUsers}}
                        <tr class="tr-hover">
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-black text-xs flex-shrink-0">{{this.name.[0]}}</div>
                                    <span class="text-sm font-semibold text-gray-800">{{this.name}}</span>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-sm text-gray-500">{{this.email}}</td>
                            <td class="px-5 py-4">
                                {{#if this.campus}}
                                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">{{this.campus.code}}</span>
                                {{else}}
                                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">GLOBAL</span>
                                {{/if}}
                            </td>
                            <td class="px-5 py-4">
                                {{#switch this.role}}
                                    {{#case 'student'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">Student</span>{{/case}}
                                    {{#case 'registrar'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-indigo-100 text-indigo-700">Registrar</span>{{/case}}
                                    {{#case 'admin'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-700">Campus Admin</span>{{/case}}
                                    {{#case 'superadmin'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700"><i class="fas fa-crown mr-1"></i>Super Admin</span>{{/case}}
                                {{/switch}}
                            </td>
                            <td class="px-5 py-4">
                                {{#switch this.status}}
                                    {{#case 'active'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">Active</span>{{/case}}
                                    {{#case 'inactive'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600">Inactive</span>{{/case}}
                                    {{#case 'suspended'}}<span class="px-2 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">Suspended</span>{{/case}}
                                {{/switch}}
                            </td>
                            <td class="px-5 py-4">
                                <a href="/superadmin/users/{{this.id}}" class="text-emerald-600 hover:text-emerald-800 font-bold text-xs transition inline-flex items-center gap-1">View <i class="fas fa-arrow-right text-xs"></i></a>
                            </td>
                        </tr>
                        {{else}}
                        <tr><td colspan="6" class="px-5 py-10 text-center text-gray-400 text-sm">No users found</td></tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    {{>footer}}
</body>
</html>
