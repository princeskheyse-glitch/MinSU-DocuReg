<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
    <title>Global Analytics — MinSU DocuReg</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @keyframes fadeInUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        .anim-up { animation:fadeInUp .5s ease-out both; }
        .d1{animation-delay:.05s} .d2{animation-delay:.1s} .d3{animation-delay:.15s} .d4{animation-delay:.2s}
        .chart-card { transition:transform .25s,box-shadow .25s; }
        .chart-card:hover { transform:translateY(-4px); box-shadow:0 16px 32px rgba(0,0,0,.15); }
    </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-gradient-to-br from-gray-900 via-emerald-950 to-gray-900 min-h-screen flex flex-col pt-20">
    {{>navbar}}
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">

        <!-- Header -->
        <div class="mb-8">
            <a href="/superadmin/dashboard" class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-semibold text-sm mb-4 group transition">
                <span class="w-7 h-7 rounded-full bg-white bg-opacity-10 flex items-center justify-center group-hover:bg-opacity-20 transition">
                    <i class="fas fa-arrow-left text-xs"></i>
                </span>
                Back to Dashboard
            </a>
            <div class="inline-flex items-center gap-2 bg-yellow-400 bg-opacity-20 text-yellow-300 text-xs font-bold px-3 py-1 rounded-full mb-2">
                <i class="fas fa-crown"></i> SUPER ADMIN — GLOBAL VIEW
            </div>
            <h1 class="text-3xl font-black text-white">Global Analytics</h1>
            <p class="text-gray-400 text-sm mt-1">Cross-campus system performance — all 3 campuses</p>
        </div>

        <!-- Metric Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
            <div class="anim-up d1 bg-gradient-to-br from-emerald-600 to-teal-600 rounded-2xl p-6 text-white shadow-lg">
                <p class="text-emerald-100 text-xs font-bold uppercase tracking-wide mb-1">Total Requests</p>
                <p class="text-4xl font-black" id="m-total-requests">—</p>
                <p class="text-emerald-200 text-xs mt-1">All campuses</p>
            </div>
            <div class="anim-up d2 bg-gray-800 rounded-2xl p-6 text-white shadow-lg border border-gray-700">
                <p class="text-amber-400 text-xs font-bold uppercase tracking-wide mb-1">Pending</p>
                <p class="text-4xl font-black text-amber-400" id="m-pending">—</p>
                <p class="text-gray-400 text-xs mt-1">Awaiting review</p>
            </div>
            <div class="anim-up d3 bg-gray-800 rounded-2xl p-6 text-white shadow-lg border border-gray-700">
                <p class="text-violet-400 text-xs font-bold uppercase tracking-wide mb-1">Total Users</p>
                <p class="text-4xl font-black text-violet-400" id="m-total-users">—</p>
                <p class="text-gray-400 text-xs mt-1">All roles</p>
            </div>
            <div class="anim-up d4 bg-gray-800 rounded-2xl p-6 text-white shadow-lg border border-gray-700">
                <p class="text-teal-400 text-xs font-bold uppercase tracking-wide mb-1">Completion Rate</p>
                <p class="text-4xl font-black text-teal-400" id="m-completion">—</p>
                <p class="text-gray-400 text-xs mt-1">Completed vs total</p>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

            <!-- Requests by Status -->
            <div class="anim-up d2 chart-card bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h2 class="text-white font-black text-base mb-5 flex items-center gap-2">
                    <i class="fas fa-chart-bar text-amber-400"></i> Requests by Status
                </h2>
                <canvas id="statusChart" style="max-height:260px"></canvas>
            </div>

            <!-- Requests by Campus -->
            <div class="anim-up d3 chart-card bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h2 class="text-white font-black text-base mb-5 flex items-center gap-2">
                    <i class="fas fa-university text-emerald-400"></i> Requests by Campus
                </h2>
                <canvas id="campusChart" style="max-height:260px"></canvas>
            </div>
        </div>

        <!-- Charts Row 2 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

            <!-- Requests by Document Type -->
            <div class="anim-up d3 chart-card bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h2 class="text-white font-black text-base mb-5 flex items-center gap-2">
                    <i class="fas fa-file-alt text-blue-400"></i> Requests by Document Type
                </h2>
                <canvas id="typeChart" style="max-height:260px"></canvas>
            </div>

            <!-- Users by Role -->
            <div class="anim-up d4 chart-card bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h2 class="text-white font-black text-base mb-5 flex items-center gap-2">
                    <i class="fas fa-users text-violet-400"></i> Users by Role
                </h2>
                <canvas id="roleChart" style="max-height:260px"></canvas>
            </div>
        </div>

        <!-- Per-Campus Breakdown Table -->
        <div class="anim-up d4 bg-gray-800 rounded-2xl border border-gray-700 overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-emerald-700 to-teal-700 px-6 py-4">
                <h2 class="text-white font-black text-base flex items-center gap-2">
                    <i class="fas fa-table"></i> Per-Campus Request Breakdown
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-900 border-b border-gray-700">
                        <tr>
                            <th class="px-5 py-3 text-left text-xs font-bold text-gray-400 uppercase">Campus</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-gray-400 uppercase">Total</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-amber-400 uppercase">Pending</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-blue-400 uppercase">Processing</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-emerald-400 uppercase">Ready</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-teal-400 uppercase">Completed</th>
                            <th class="px-5 py-3 text-center text-xs font-bold text-red-400 uppercase">Rejected</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700" id="campus-table-body">
                        {{#each campuses}}
                        <tr class="hover:bg-gray-750 transition">
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-900 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-university text-emerald-400 text-xs"></i>
                                    </div>
                                    <div>
                                        <p class="text-white font-bold text-sm">{{this.name}}</p>
                                        <p class="text-gray-400 text-xs">{{this.code}}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-center text-white font-bold" id="ct-total-{{this.id}}">—</td>
                            <td class="px-5 py-4 text-center text-amber-400 font-bold" id="ct-pending-{{this.id}}">—</td>
                            <td class="px-5 py-4 text-center text-blue-400 font-bold" id="ct-processing-{{this.id}}">—</td>
                            <td class="px-5 py-4 text-center text-emerald-400 font-bold" id="ct-ready-{{this.id}}">—</td>
                            <td class="px-5 py-4 text-center text-teal-400 font-bold" id="ct-completed-{{this.id}}">—</td>
                            <td class="px-5 py-4 text-center text-red-400 font-bold" id="ct-rejected-{{this.id}}">—</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Most Requested + User Status -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="anim-up d3 bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="text-white font-black text-base mb-4 flex items-center gap-2">
                    <i class="fas fa-star text-yellow-400"></i> Most Requested Documents
                </h3>
                <div class="space-y-2" id="top-docs"></div>
            </div>
            <div class="anim-up d4 bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="text-white font-black text-base mb-4 flex items-center gap-2">
                    <i class="fas fa-toggle-on text-emerald-400"></i> User Status Overview
                </h3>
                <canvas id="userStatusChart" style="max-height:220px"></canvas>
            </div>
        </div>

    </main>
    {{>footer}}

    <script>
        // ── Data from controller ──
        const byStatus            = {{{json requestsByStatus}}};
        const byType              = {{{json requestsByType}}};
        const byCampus            = {{{json requestsByCampus}}};
        const byCampusStatus      = {{{json requestsByCampusStatus}}};
        const byRole              = {{{json userStats.byRole}}};
        const byUserStatus        = {{{json userStats.byStatus}}};
        const campuses            = {{{json campuses}}};

        function getCount(arr, key, field) {
            const item = arr.find(r => r[field] === key);
            return item ? parseInt(item.count) : 0;
        }

        // ── Metric cards ──
        const totalRequests  = byStatus.reduce((s, r) => s + parseInt(r.count), 0);
        const totalUsers     = byRole.reduce((s, r) => s + parseInt(r.count), 0);
        const completedCount = getCount(byStatus, 'completed', 'status');
        const pendingCount   = getCount(byStatus, 'pending', 'status');
        const completionRate = totalRequests > 0 ? Math.round((completedCount / totalRequests) * 100) : 0;

        document.getElementById('m-total-requests').textContent = totalRequests;
        document.getElementById('m-pending').textContent        = pendingCount;
        document.getElementById('m-total-users').textContent    = totalUsers;
        document.getElementById('m-completion').textContent     = completionRate + '%';

        const darkOpts = {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { position: 'bottom', labels: { color: '#d1d5db', padding: 12, usePointStyle: true } }
            }
        };

        // ── Requests by Status ──
        const statusOrder  = ['pending','processing','ready','completed','rejected'];
        const statusLabels = ['Pending','Processing','Ready','Completed','Rejected'];
        const statusColors = ['rgba(234,179,8,.85)','rgba(59,130,246,.85)','rgba(34,197,94,.85)','rgba(20,184,166,.85)','rgba(239,68,68,.85)'];
        new Chart(document.getElementById('statusChart'), {
            type: 'bar',
            data: {
                labels: statusLabels,
                datasets: [{ label: 'Requests', data: statusOrder.map(s => getCount(byStatus, s, 'status')),
                    backgroundColor: statusColors, borderRadius: 6 }]
            },
            options: { ...darkOpts,
                scales: {
                    y: { beginAtZero: true, ticks: { color:'#9ca3af', stepSize:1 }, grid: { color:'rgba(75,85,99,.3)' } },
                    x: { ticks: { color:'#9ca3af' }, grid: { display:false } }
                }
            }
        });

        // ── Requests by Campus ──
        const campusLabels = campuses.map(c => c.code);
        const campusColors = ['rgba(16,185,129,.85)','rgba(59,130,246,.85)','rgba(168,85,247,.85)'];
        const campusCounts = campuses.map(c => {
            const found = byCampus.find(r => r.campusId === c.id);
            return found ? parseInt(found.count) : 0;
        });
        new Chart(document.getElementById('campusChart'), {
            type: 'doughnut',
            data: {
                labels: campuses.map(c => c.name),
                datasets: [{ data: campusCounts, backgroundColor: campusColors, borderWidth: 3, borderColor: '#1f2937' }]
            },
            options: darkOpts
        });

        // ── Requests by Document Type ──
        const docTypeMap = {
            transcript: 'Transcript', transfer_credentials: 'Transfer Creds',
            diploma_copy: '2nd Diploma', certificate: 'Certificate',
            verification: 'Verification', enrollment_certificate: 'Enrollment', good_moral: 'Good Moral'
        };
        const typeOrder  = Object.keys(docTypeMap);
        const typeColors = ['rgba(168,85,247,.85)','rgba(236,72,153,.85)','rgba(59,130,246,.85)','rgba(34,197,94,.85)','rgba(234,179,8,.85)','rgba(249,115,22,.85)','rgba(20,184,166,.85)'];
        new Chart(document.getElementById('typeChart'), {
            type: 'bar',
            data: {
                labels: typeOrder.map(t => docTypeMap[t]),
                datasets: [{ label: 'Requests', data: typeOrder.map(t => getCount(byType, t, 'documentType')),
                    backgroundColor: typeColors, borderRadius: 6 }]
            },
            options: { ...darkOpts,
                scales: {
                    y: { beginAtZero: true, ticks: { color:'#9ca3af', stepSize:1 }, grid: { color:'rgba(75,85,99,.3)' } },
                    x: { ticks: { color:'#9ca3af', font:{ size:10 } }, grid: { display:false } }
                }
            }
        });

        // ── Users by Role ──
        const roleLabels = byRole.map(r => r.role.charAt(0).toUpperCase() + r.role.slice(1));
        const roleCounts = byRole.map(r => parseInt(r.count));
        const roleColors = ['rgba(59,130,246,.85)','rgba(168,85,247,.85)','rgba(249,115,22,.85)','rgba(234,179,8,.85)'];
        new Chart(document.getElementById('roleChart'), {
            type: 'doughnut',
            data: {
                labels: roleLabels,
                datasets: [{ data: roleCounts, backgroundColor: roleColors, borderWidth: 3, borderColor: '#1f2937' }]
            },
            options: darkOpts
        });

        // ── User Status ──
        const uStatusLabels = byUserStatus.map(r => r.status.charAt(0).toUpperCase() + r.status.slice(1));
        const uStatusCounts = byUserStatus.map(r => parseInt(r.count));
        const uStatusColors = ['rgba(34,197,94,.85)','rgba(156,163,175,.85)','rgba(239,68,68,.85)'];
        new Chart(document.getElementById('userStatusChart'), {
            type: 'doughnut',
            data: {
                labels: uStatusLabels,
                datasets: [{ data: uStatusCounts, backgroundColor: uStatusColors, borderWidth: 3, borderColor: '#1f2937' }]
            },
            options: darkOpts
        });

        // ── Per-campus table ──
        campuses.forEach(campus => {
            const statuses = ['pending','processing','ready','completed','rejected'];
            let total = 0;
            statuses.forEach(s => {
                const found = byCampusStatus.find(r => r.campusId === campus.id && r.status === s);
                const count = found ? parseInt(found.count) : 0;
                total += count;
                const el = document.getElementById(`ct-${s}-${campus.id}`);
                if (el) el.textContent = count || '0';
            });
            const totalEl = document.getElementById(`ct-total-${campus.id}`);
            if (totalEl) totalEl.textContent = total;
        });

        // ── Most Requested ──
        const sorted = [...byType].sort((a,b) => parseInt(b.count) - parseInt(a.count));
        const topEl = document.getElementById('top-docs');
        if (!sorted.length) {
            topEl.innerHTML = '<p class="text-gray-500 text-sm text-center py-4">No requests yet</p>';
        } else {
            topEl.innerHTML = sorted.slice(0,5).map((item, i) => `
                <div class="flex items-center justify-between p-3 bg-gray-700 rounded-xl hover:bg-gray-600 transition">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-full bg-emerald-600 flex items-center justify-center text-white text-xs font-black">${i+1}</div>
                        <span class="text-gray-100 font-semibold text-sm">${docTypeMap[item.documentType] || item.documentType}</span>
                    </div>
                    <span class="text-emerald-400 font-black">${item.count}</span>
                </div>`).join('');
        }
    </script>
</body>
</html>
