<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
  <title>Student Dashboard - MinSU DocuReg</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes fadeInUp   { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeInDown { from{opacity:0;transform:translateY(-28px)} to{opacity:1;transform:translateY(0)} }
    @keyframes pulse-ring { 0%,100%{opacity:1} 50%{opacity:0.6} }
    .anim-up   { animation:fadeInUp .55s ease-out both; }
    .anim-down { animation:fadeInDown .55s ease-out both; }
    .d1{animation-delay:.08s} .d2{animation-delay:.16s} .d3{animation-delay:.24s}
    .d4{animation-delay:.32s} .d5{animation-delay:.40s} .d6{animation-delay:.48s}
    .card-hover { transition:transform .3s cubic-bezier(.175,.885,.32,1.275),box-shadow .3s; }
    .card-hover:hover { transform:translateY(-5px); box-shadow:0 16px 32px rgba(0,0,0,.1); }
    .tr-hover { transition:background .18s; }
    .tr-hover:hover { background:#f0fdf4; }
    .pulse-ring { animation:pulse-ring 2s ease-in-out infinite; }
    html, body { max-width:100%; overflow-x:hidden; }
    *, *::before, *::after { box-sizing:border-box; }
  </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-emerald-50 to-teal-50 min-h-screen flex flex-col">
  {{>navbar}}
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">

    <!-- Hero greeting -->
    <div class="anim-down mb-8">
      <p class="text-emerald-600 font-semibold text-sm uppercase tracking-wider mb-1">Student Portal</p>
      <h1 class="text-xl sm:text-3xl md:text-4xl font-black text-gray-800 leading-tight">
        Welcome back, <span class="text-emerald-600">{{user.name}}</span>!
      </h1>
      <p class="text-gray-500 mt-1 text-sm">Here's your document request overview.</p>
    </div>

    <!-- Appointment alert -->
    {{#if upcomingAppointments.length}}
    <div class="anim-up mb-8 bg-gradient-to-r from-emerald-50 to-teal-50 border-2 border-emerald-300 rounded-2xl p-4 sm:p-6 shadow-lg overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-200 opacity-20 rounded-full blur-2xl pointer-events-none"></div>
      <div class="flex items-start gap-3 relative">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0 pulse-ring">
          <i class="fas fa-calendar-check text-emerald-600 text-lg"></i>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base sm:text-lg font-black text-emerald-800 mb-3">Upcoming Pickup Appointments</h3>
          <div class="space-y-2">
            {{#each upcomingAppointments}}
            <div class="bg-white rounded-xl p-3 sm:p-4 border-l-4 border-emerald-500 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <p class="text-xs text-gray-500 flex items-center gap-1">
                  <i class="fas fa-clock flex-shrink-0"></i>
                  {{formatDate appointmentDate}} at {{formatTime appointmentTime}}
                </p>
                <span class="bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full flex-shrink-0">Scheduled</span>
              </div>
            </div>
            {{/each}}
          </div>
          <p class="text-xs text-emerald-600 mt-3 flex items-center gap-1">
            <i class="fas fa-info-circle flex-shrink-0"></i>
            Please arrive 5-10 minutes before your scheduled time.
          </p>
        </div>
      </div>
    </div>
    {{/if}}

    <!-- Stats — 2 cols mobile, 3 cols sm, 5 cols md+ -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4 mb-8">
      <div class="card-hover anim-up d1 bg-white rounded-2xl shadow-md p-4 sm:p-5 border-t-4 border-violet-500">
        <p class="text-violet-500 text-xs font-bold uppercase tracking-wider mb-1">Total</p>
        <p class="text-3xl sm:text-4xl font-black text-violet-600">{{stats.total}}</p>
        <p class="text-gray-400 text-xs mt-1">All requests</p>
      </div>
      <div class="card-hover anim-up d2 bg-white rounded-2xl shadow-md p-4 sm:p-5 border-t-4 border-amber-400">
        <p class="text-amber-500 text-xs font-bold uppercase tracking-wider mb-1">Pending</p>
        <p class="text-3xl sm:text-4xl font-black text-amber-500">{{stats.pending}}</p>
        <p class="text-gray-400 text-xs mt-1">Awaiting review</p>
      </div>
      <div class="card-hover anim-up d3 bg-white rounded-2xl shadow-md p-4 sm:p-5 border-t-4 border-blue-500">
        <p class="text-blue-500 text-xs font-bold uppercase tracking-wider mb-1">Processing</p>
        <p class="text-3xl sm:text-4xl font-black text-blue-500">{{stats.processing}}</p>
        <p class="text-gray-400 text-xs mt-1">Being prepared</p>
      </div>
      <div class="card-hover anim-up d4 bg-white rounded-2xl shadow-md p-4 sm:p-5 border-t-4 border-emerald-500">
        <p class="text-emerald-500 text-xs font-bold uppercase tracking-wider mb-1">Ready</p>
        <p class="text-3xl sm:text-4xl font-black text-emerald-500">{{stats.ready}}</p>
        <p class="text-gray-400 text-xs mt-1">For pickup</p>
      </div>
      <!-- 5th card: on mobile (2-col grid) this is the 5th item — spans 2 cols to fill the row -->
      <div class="card-hover anim-up d5 col-span-2 sm:col-span-1 bg-white rounded-2xl shadow-md p-4 sm:p-5 border-t-4 border-teal-500">
        <p class="text-teal-500 text-xs font-bold uppercase tracking-wider mb-1">Completed</p>
        <p class="text-3xl sm:text-4xl font-black text-teal-500">{{stats.completed}}</p>
        <p class="text-gray-400 text-xs mt-1">Done</p>
      </div>
    </div>

    <!-- Action cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-8">
      <div class="card-hover anim-up d4 relative bg-gradient-to-br from-emerald-600 via-green-600 to-teal-600 rounded-2xl shadow-xl p-6 sm:p-8 text-white overflow-hidden">
        <div class="absolute top-0 right-0 w-40 h-40 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <i class="fas fa-plus-circle text-6xl opacity-20 absolute bottom-4 right-6"></i>
        <div class="relative">
          <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center mb-4">
            <i class="fas fa-file-plus text-white text-xl sm:text-2xl"></i>
          </div>
          <h3 class="text-xl sm:text-2xl font-black mb-2">Request Document</h3>
          <p class="text-emerald-100 text-sm mb-5">Submit a new document request for processing.</p>
          <a href="/student/request/new" class="inline-flex items-center space-x-2 bg-white text-emerald-700 font-bold px-4 py-2.5 rounded-xl hover:bg-emerald-50 transition shadow-md hover:shadow-lg hover:scale-105 text-sm">
            <i class="fas fa-arrow-right text-xs"></i><span>Request Document</span>
          </a>
        </div>
      </div>
      <div class="card-hover anim-up d5 relative bg-gradient-to-br from-teal-600 via-cyan-600 to-blue-600 rounded-2xl shadow-xl p-6 sm:p-8 text-white overflow-hidden">
        <div class="absolute top-0 right-0 w-40 h-40 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <i class="fas fa-list text-6xl opacity-20 absolute bottom-4 right-6"></i>
        <div class="relative">
          <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center mb-4">
            <i class="fas fa-clipboard-list text-white text-xl sm:text-2xl"></i>
          </div>
          <h3 class="text-xl sm:text-2xl font-black mb-2">My Requests</h3>
          <p class="text-teal-100 text-sm mb-5">View and track all your document requests.</p>
          <a href="/student/requests" class="inline-flex items-center space-x-2 bg-white text-teal-700 font-bold px-4 py-2.5 rounded-xl hover:bg-teal-50 transition shadow-md hover:shadow-lg hover:scale-105 text-sm">
            <i class="fas fa-eye text-xs"></i><span>View Requests</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Recent requests table -->
    <div class="anim-up d6 bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 sm:px-8 py-5 flex items-center justify-between">
        <h2 class="text-white text-lg sm:text-xl font-black flex items-center">
          <i class="fas fa-history mr-3 text-emerald-400"></i>Recent Requests
        </h2>
        <a href="/student/requests" class="text-emerald-400 hover:text-emerald-300 text-sm font-semibold transition">View all</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Document</th>
              <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
              <th class="hidden sm:table-cell px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#if recentRequests.length}}
              {{#each recentRequests}}
              <tr class="tr-hover">
                <td class="px-4 sm:px-6 py-4 text-sm font-semibold text-gray-800">
                  <div class="flex items-center space-x-2">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-file-alt text-emerald-600 text-xs"></i>
                    </div>
                    <span class="truncate max-w-[100px] sm:max-w-none">{{formatDocType this.documentType}}</span>
                  </div>
                </td>
                <td class="px-4 sm:px-6 py-4">
                  {{#switch this.status}}
                    {{#case 'pending'}}<span class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700"><i class="fas fa-hourglass-start mr-1"></i>Pending</span>{{/case}}
                    {{#case 'processing'}}<span class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700"><i class="fas fa-cog mr-1"></i>Processing</span>{{/case}}
                    {{#case 'ready'}}<span class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700"><i class="fas fa-check-circle mr-1"></i>Ready</span>{{/case}}
                    {{#case 'completed'}}<span class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs font-bold bg-teal-100 text-teal-700"><i class="fas fa-check-double mr-1"></i>Done</span>{{/case}}
                    {{#case 'rejected'}}<span class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700"><i class="fas fa-times-circle mr-1"></i>Rejected</span>{{/case}}
                  {{/switch}}
                </td>
                <td class="hidden sm:table-cell px-6 py-4 text-sm text-gray-500">{{formatDate this.createdAt}}</td>
                <td class="px-4 sm:px-6 py-4">
                  <a href="/student/requests/{{this.id}}" class="inline-flex items-center text-emerald-600 hover:text-emerald-800 font-bold text-sm transition hover:translate-x-1">
                    <i class="fas fa-arrow-right mr-1"></i><span class="hidden sm:inline">Details</span>
                  </a>
                </td>
              </tr>
              {{/each}}
            {{else}}
            <tr>
              <td colspan="4" class="px-6 py-16 text-center">
                <div class="flex flex-col items-center">
                  <div class="w-16 h-16 rounded-2xl bg-gray-100 flex items-center justify-center mb-4">
                    <i class="fas fa-inbox text-gray-400 text-2xl"></i>
                  </div>
                  <p class="text-gray-500 font-semibold">No requests yet</p>
                  <a href="/student/request/new" class="mt-3 text-emerald-600 font-bold text-sm hover:underline">Create your first request</a>
                </div>
              </td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </main>
  {{>footer}}
</body>
</html>
