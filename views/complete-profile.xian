<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
  <title>Complete Your Profile — MinSU DocuReg</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes fadeInUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }
    @keyframes float    { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
    .anim-up   { animation:fadeInUp .5s ease-out both; }
    .anim-float{ animation:float 3.5s ease-in-out infinite; }
    .input-field { transition:border-color .2s,box-shadow .2s; }
    .input-field:focus { box-shadow:0 4px 14px rgba(5,150,105,.15); }
    .btn-glow { transition:all .2s ease; }
    .btn-glow:hover { box-shadow:0 10px 24px rgba(5,150,105,.35); transform:scale(1.02); }
    .campus-label { transition:border-color .2s,background .2s; }
    .campus-label:hover { border-color:#6ee7b7; background:#f0fdf4; }
  </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-100 min-h-screen py-8 px-4">

  <div class="max-w-lg mx-auto anim-up">

    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden border border-emerald-100">

      <!-- Header -->
      <div class="relative bg-gradient-to-br from-emerald-600 via-green-600 to-teal-600 px-6 py-8 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-3 right-3 w-20 h-20 border-2 border-white rounded-full"></div>
          <div class="absolute bottom-3 left-3 w-12 h-12 border-2 border-white rounded-full"></div>
        </div>

        <!-- Google avatar or logo -->
        {{#if user.photoURL}}
        <div class="relative anim-float mb-3">
          <img src="{{user.photoURL}}" alt="Profile" class="w-16 h-16 rounded-full mx-auto shadow-xl border-4 border-white border-opacity-40 object-cover">
        </div>
        {{else}}
        <div class="relative anim-float mb-3">
          <div class="w-16 h-16 rounded-full bg-white mx-auto flex items-center justify-center shadow-xl overflow-hidden">
            <img src="/images/logo/minsu-logo.png" alt="MinSU Logo" class="w-14 h-14 object-contain">
          </div>
        </div>
        {{/if}}

        <h1 class="text-white text-2xl font-black">Almost there, {{user.name}}!</h1>
        <p class="text-emerald-100 text-sm mt-1">Complete your profile to access MinSU DocuReg</p>
      </div>

      <!-- Progress indicator -->
      <div class="bg-emerald-50 border-b border-emerald-100 px-6 py-3 flex items-center gap-3">
        <div class="flex items-center gap-2 text-emerald-600">
          <div class="w-6 h-6 rounded-full bg-emerald-600 flex items-center justify-center">
            <i class="fas fa-check text-white text-xs"></i>
          </div>
          <span class="text-xs font-bold">Google Sign-In</span>
        </div>
        <div class="flex-1 h-0.5 bg-emerald-200"></div>
        <div class="flex items-center gap-2 text-emerald-600">
          <div class="w-6 h-6 rounded-full bg-emerald-600 border-2 border-emerald-600 flex items-center justify-center">
            <span class="text-white text-xs font-black">2</span>
          </div>
          <span class="text-xs font-bold">Complete Profile</span>
        </div>
        <div class="flex-1 h-0.5 bg-gray-200"></div>
        <div class="flex items-center gap-2 text-gray-400">
          <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500 text-xs font-black">3</span>
          </div>
          <span class="text-xs font-semibold">Dashboard</span>
        </div>
      </div>

      <div class="px-6 py-6">

        {{#if error}}
        <div class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
          <i class="fas fa-exclamation-circle text-red-500 flex-shrink-0"></i>
          <p class="text-red-600 text-sm font-medium">{{error}}</p>
        </div>
        {{/if}}

        <div class="mb-5 bg-blue-50 border border-blue-200 rounded-xl px-4 py-3 flex items-start gap-3">
          <i class="fas fa-info-circle text-blue-500 mt-0.5 flex-shrink-0"></i>
          <p class="text-blue-700 text-sm">You signed in with <strong>{{user.email}}</strong>. Please fill in the details below to complete your registration.</p>
        </div>

        <form method="POST" action="/complete-profile" class="space-y-5">

          <!-- Full Name (pre-filled from Google, editable) -->
          <div>
            <label for="name" class="block text-gray-700 font-bold text-sm mb-1.5">
              <i class="fas fa-user text-emerald-500 mr-1.5"></i>Full Name <span class="text-red-500">*</span>
            </label>
            <input type="text" id="name" name="name" required value="{{user.name}}" placeholder="Juan Dela Cruz"
              class="input-field w-full px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm bg-gray-50 focus:bg-white">
          </div>

          <!-- Student ID -->
          <div>
            <label for="studentId" class="block text-gray-700 font-bold text-sm mb-1.5">
              <i class="fas fa-id-card text-emerald-500 mr-1.5"></i>Student ID
              <span class="text-gray-400 font-normal text-xs">(optional)</span>
            </label>
            <input type="text" id="studentId" name="studentId" placeholder="2024-001234"
              class="input-field w-full px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm bg-gray-50 focus:bg-white">
          </div>

          <!-- Campus Selection -->
          <div>
            <label class="block text-gray-700 font-bold text-sm mb-2">
              <i class="fas fa-university text-emerald-500 mr-1.5"></i>Select Your Campus <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              {{#each campuses}}
              <label class="cursor-pointer" id="campus-label-{{this.id}}">
                <input type="radio" name="campusId" value="{{this.id}}" required class="sr-only campus-radio">
                <div class="campus-label border-2 border-gray-200 rounded-xl p-3 text-center flex flex-col items-center justify-center gap-1.5 h-full">
                  <div class="w-9 h-9 rounded-lg bg-emerald-100 flex items-center justify-center">
                    <i class="fas fa-university text-emerald-600 text-sm"></i>
                  </div>
                  <p class="text-xs font-bold text-gray-800 leading-tight">{{this.name}}</p>
                  <p class="text-xs text-gray-400">{{this.code}}</p>
                </div>
              </label>
              {{/each}}
            </div>
            <p class="text-gray-400 text-xs mt-1.5 flex items-center gap-1">
              <i class="fas fa-info-circle text-emerald-400"></i> Select the campus where you are enrolled
            </p>
          </div>

          <button type="submit"
            class="btn-glow w-full bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold py-3 rounded-xl shadow-lg flex items-center justify-center gap-2">
            <i class="fas fa-check-circle"></i>
            <span>Complete Registration</span>
          </button>
        </form>

        <div class="mt-4 text-center">
          <a href="/logout" class="text-gray-400 hover:text-gray-600 text-xs transition">
            <i class="fas fa-sign-out-alt mr-1"></i>Sign out and use a different account
          </a>
        </div>
      </div>
    </div>

    <p class="text-center text-gray-400 text-xs mt-4 pb-4">&copy; 2025 Mindoro State University</p>
  </div>

  <script>
    document.querySelectorAll('.campus-radio').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.campus-label').forEach(l => {
          l.style.borderColor = '';
          l.style.backgroundColor = '';
        });
        if (radio.checked) {
          radio.closest('label').querySelector('.campus-label').style.borderColor = '#059669';
          radio.closest('label').querySelector('.campus-label').style.backgroundColor = '#ecfdf5';
        }
      });
    });
  </script>
</body>
</html>
