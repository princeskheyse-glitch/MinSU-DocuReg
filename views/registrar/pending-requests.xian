<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
  <title>Pending Requests - MinSU DocuReg</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes fadeInUp   { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeInDown { from{opacity:0;transform:translateY(-20px)} to{opacity:1;transform:translateY(0)} }
    .anim-up   { animation:fadeInUp .45s ease-out both; }
    .anim-down { animation:fadeInDown .45s ease-out both; }
    *, *::before, *::after { box-sizing: border-box; }
  </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-amber-50 to-orange-50 min-h-screen flex flex-col">
  {{>navbar}}
  <div class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">

    <div class="anim-down mb-6">
      <a href="{{basePath}}/dashboard" class="inline-flex items-center gap-2 text-amber-700 hover:text-amber-900 font-semibold text-sm mb-4 group transition">
        <span class="w-7 h-7 rounded-full bg-white shadow flex items-center justify-center group-hover:bg-amber-50 transition">
          <i class="fas fa-arrow-left text-xs text-amber-600"></i>
        </span>
        Back to Dashboard
      </a>
      <p class="text-amber-600 font-semibold text-sm uppercase tracking-wider mb-1">Registrar Portal</p>
      <h1 class="text-2xl sm:text-3xl font-black text-gray-800">Pending Requests</h1>
      <p class="text-gray-500 mt-1 text-sm">Review and process student document requests</p>
    </div>

    <!-- ── MOBILE: card list ── -->
    <div class="sm:hidden anim-up space-y-3">
      {{#each requests}}
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-black text-sm flex-shrink-0">
              {{this.student.name.[0]}}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-bold text-gray-800 truncate">{{this.student.name}}</p>
              <p class="text-xs text-gray-400 font-mono">{{this.student.studentId}}</p>
            </div>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">{{formatDate this.createdAt}}</span>
        </div>
        <div class="ml-12 space-y-2">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">
            <i class="fas fa-file mr-1"></i>{{formatDocType this.documentType}}
          </span>
          {{#if this.purpose}}
          <p class="text-xs text-gray-500 truncate">{{this.purpose}}</p>
          {{/if}}
        </div>
        <div class="mt-3 flex justify-end">
          <a href="{{../basePath}}/requests/{{this.id}}"
            class="inline-flex items-center gap-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold px-4 py-2 rounded-xl text-xs shadow">
            <i class="fas fa-arrow-right"></i>Process Request
          </a>
        </div>
      </div>
      {{else}}
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-10 text-center">
        <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center mb-3 mx-auto">
          <i class="fas fa-check-circle text-emerald-500 text-xl"></i>
        </div>
        <p class="text-gray-700 font-bold">All caught up!</p>
        <p class="text-gray-400 text-sm mt-1">No pending requests at the moment.</p>
      </div>
      {{/each}}
    </div>

    <!-- ── DESKTOP: table ── -->
    <div class="hidden sm:block anim-up bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-5">
        <h2 class="text-white text-lg font-black flex items-center"><i class="fas fa-tasks mr-3"></i>Pending Requests</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-5 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Student</th>
              <th class="px-5 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Document</th>
              <th class="hidden md:table-cell px-5 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Purpose</th>
              <th class="px-5 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-5 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each requests}}
            <tr class="hover:bg-amber-50 transition">
              <td class="px-5 py-4">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-black text-xs flex-shrink-0">
                    {{this.student.name.[0]}}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-gray-800">{{this.student.name}}</p>
                    <p class="text-xs text-gray-400 font-mono">{{this.student.studentId}}</p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">
                  <i class="fas fa-file mr-1.5"></i>{{formatDocType this.documentType}}
                </span>
              </td>
              <td class="hidden md:table-cell px-5 py-4 text-sm text-gray-500 max-w-xs truncate">{{this.purpose}}</td>
              <td class="px-5 py-4 text-sm text-gray-500">{{formatDate this.createdAt}}</td>
              <td class="px-5 py-4">
                <a href="{{../basePath}}/requests/{{this.id}}"
                  class="inline-flex items-center gap-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold px-4 py-2 rounded-lg text-xs shadow-md hover:shadow-lg transition">
                  <i class="fas fa-arrow-right"></i>Process
                </a>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="5" class="px-6 py-16 text-center">
                <div class="flex flex-col items-center">
                  <div class="w-16 h-16 rounded-2xl bg-emerald-100 flex items-center justify-center mb-4">
                    <i class="fas fa-check-circle text-emerald-500 text-2xl"></i>
                  </div>
                  <p class="text-gray-700 font-bold">All caught up!</p>
                  <p class="text-gray-400 text-sm mt-1">No pending requests at the moment.</p>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {{>footer}}
</body>
</html>
