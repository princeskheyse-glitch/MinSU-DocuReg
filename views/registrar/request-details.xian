<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
    <title>Request Details - MinSU DocuReg</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes fadeInUp   { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }
        @keyframes fadeInDown { from{opacity:0;transform:translateY(-24px)} to{opacity:1;transform:translateY(0)} }
        .anim-up   { animation:fadeInUp .5s ease-out both; }
        .anim-down { animation:fadeInDown .5s ease-out both; }
        .d1{animation-delay:.05s} .d2{animation-delay:.1s} .d3{animation-delay:.15s} .d4{animation-delay:.2s}
        .info-row { transition: background .15s; }
        .info-row:hover { background: #f0fdf4; }
    </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="bg-gradient-to-br from-slate-50 via-emerald-50 to-teal-50 min-h-screen flex flex-col pt-20">
    {{>navbar}}
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Breadcrumb -->
        <div class="anim-down mb-6 flex items-center gap-2 text-sm text-gray-500">
            <a href="{{basePath}}/requests" class="hover:text-emerald-600 font-semibold transition flex items-center gap-1">
                <i class="fas fa-arrow-left text-xs"></i> Back to Requests
            </a>
            <span>/</span>
            <span class="text-gray-700 font-semibold">Request Details</span>
        </div>

        <!-- ── HEADER CARD ── -->
        <div class="anim-down bg-gradient-to-r from-emerald-700 to-teal-700 rounded-2xl shadow-xl px-8 py-7 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="min-w-0">
                <p class="text-emerald-200 text-xs font-bold uppercase tracking-widest mb-1">Document Request</p>
                <h1 class="text-white text-2xl font-black truncate">{{formatDocType request.documentType}}</h1>
                <p class="text-emerald-300 text-xs mt-1 font-mono">ID: {{request.id}}</p>
            </div>
            <div class="flex-shrink-0">
                {{#switch request.status}}
                    {{#case 'pending'}}
                        <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-amber-100 text-amber-800">
                            <i class="fas fa-hourglass-start"></i> Pending
                        </span>
                    {{/case}}
                    {{#case 'processing'}}
                        <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-blue-100 text-blue-800">
                            <i class="fas fa-cog"></i> Processing
                        </span>
                    {{/case}}
                    {{#case 'ready'}}
                        <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-emerald-100 text-emerald-800">
                            <i class="fas fa-check-circle"></i> Ready for Pickup
                        </span>
                    {{/case}}
                    {{#case 'completed'}}
                        <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-teal-100 text-teal-800">
                            <i class="fas fa-check-double"></i> Completed
                        </span>
                    {{/case}}
                    {{#case 'rejected'}}
                        <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold bg-red-100 text-red-800">
                            <i class="fas fa-times-circle"></i> Rejected
                        </span>
                    {{/case}}
                {{/switch}}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- ── LEFT: STUDENT INFO + REQUEST INFO ── -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Student Information -->
                <div class="anim-up d1 bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-600 to-teal-600 px-6 py-4">
                        <h2 class="text-white font-black text-base flex items-center gap-2">
                            <i class="fas fa-user-graduate"></i> Student Information
                        </h2>
                    </div>
                    <div class="divide-y divide-gray-100">
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-black text-lg flex-shrink-0">
                                {{request.student.name.[0]}}
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Full Name</p>
                                <p class="text-gray-900 font-bold text-base truncate">{{request.student.name}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0">
                                <i class="fas fa-id-badge"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Student Number</p>
                                <p class="text-gray-900 font-bold text-base font-mono">{{request.student.studentId}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 flex-shrink-0">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Email Address</p>
                                <p class="text-gray-900 font-semibold text-sm truncate">{{request.student.email}}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Request Information -->
                <div class="anim-up d2 bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-4">
                        <h2 class="text-white font-black text-base flex items-center gap-2">
                            <i class="fas fa-file-alt"></i> Request Information
                        </h2>
                    </div>
                    <div class="divide-y divide-gray-100">
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Document Type</p>
                                <p class="text-gray-900 font-bold">{{formatDocType request.documentType}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
                                <i class="fas fa-copy"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Quantity</p>
                                <p class="text-gray-900 font-bold">{{request.quantity}} {{#if_eq request.quantity 1}}Copy{{else}}Copies{{/if_eq}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-start gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-600 flex-shrink-0 mt-0.5">
                                <i class="fas fa-pen"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Purpose</p>
                                <p class="text-gray-900 font-semibold">{{request.purpose}}</p>
                            </div>
                        </div>
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 flex-shrink-0">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Date Requested</p>
                                <p class="text-gray-900 font-bold">{{formatDate request.createdAt}}</p>
                            </div>
                        </div>
                        {{#if request.completedAt}}
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-600 flex-shrink-0">
                                <i class="fas fa-flag-checkered"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Completed Date</p>
                                <p class="text-gray-900 font-bold">{{formatDate request.completedAt}}</p>
                            </div>
                        </div>
                        {{/if}}
                        {{#if request.registrar}}
                        <div class="info-row flex items-center gap-4 px-6 py-4">
                            <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-orange-600 flex-shrink-0">
                                <i class="fas fa-user-tie"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase tracking-wide">Processed By</p>
                                <p class="text-gray-900 font-bold">{{request.registrar.name}}</p>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                </div>

                <!-- Notes / Rejection Reason -->
                {{#if request.notes}}
                <div class="anim-up d3 bg-orange-50 border border-orange-200 rounded-2xl px-6 py-5">
                    <p class="text-orange-700 text-xs font-bold uppercase tracking-wide mb-2 flex items-center gap-2">
                        <i class="fas fa-sticky-note"></i> Registrar Notes
                    </p>
                    <p class="text-gray-800 font-medium">{{request.notes}}</p>
                </div>
                {{/if}}
                {{#if request.rejectionReason}}
                <div class="anim-up d3 bg-red-50 border border-red-200 rounded-2xl px-6 py-5">
                    <p class="text-red-700 text-xs font-bold uppercase tracking-wide mb-2 flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle"></i> Rejection Reason
                    </p>
                    <p class="text-gray-800 font-medium">{{request.rejectionReason}}</p>
                </div>
                {{/if}}

                <!-- Appointments -->
                {{#if appointments.length}}
                <div class="anim-up d4 bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                        <h2 class="text-white font-black text-base flex items-center gap-2">
                            <i class="fas fa-calendar-check"></i> Scheduled Appointments
                        </h2>
                    </div>
                    <div class="divide-y divide-gray-100">
                        {{#each appointments}}
                        <div class="info-row flex items-center justify-between px-6 py-4 gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0">
                                    <i class="fas fa-clock text-sm"></i>
                                </div>
                                <div>
                                    <p class="text-gray-900 font-bold text-sm">{{formatDate this.appointmentDate}} at {{formatTime this.appointmentTime}}</p>
                                    {{#if this.notes}}<p class="text-gray-500 text-xs mt-0.5">{{this.notes}}</p>{{/if}}
                                </div>
                            </div>
                            {{#switch this.status}}
                                {{#case 'scheduled'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700 whitespace-nowrap">Scheduled</span>{{/case}}
                                {{#case 'completed'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 whitespace-nowrap">Completed</span>{{/case}}
                                {{#case 'missed'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700 whitespace-nowrap">Missed</span>{{/case}}
                                {{#case 'cancelled'}}<span class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 whitespace-nowrap">Cancelled</span>{{/case}}
                            {{/switch}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- ── RIGHT: ACTIONS ── -->
            <div class="space-y-4">

                <!-- Status Actions -->
                {{#unless_eq request.status 'completed'}}
                {{#unless_eq request.status 'rejected'}}
                <div class="anim-up d1 bg-white rounded-2xl shadow-md p-6">
                    <h3 class="text-gray-800 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-tasks text-emerald-600"></i> Update Status
                    </h3>
                    <div class="space-y-3">
                        {{#if_eq request.status 'pending'}}
                        <button onclick="openStatusModal('processing')"
                            class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-3 px-4 rounded-xl shadow transition hover:scale-105">
                            <i class="fas fa-cog"></i> Start Processing
                        </button>
                        {{/if_eq}}
                        {{#if_eq request.status 'processing'}}
                        <button onclick="openStatusModal('ready')"
                            class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold py-3 px-4 rounded-xl shadow transition hover:scale-105">
                            <i class="fas fa-check-circle"></i> Mark as Ready
                        </button>
                        {{/if_eq}}
                        {{#if_eq request.status 'ready'}}
                        <button onclick="openStatusModal('completed')"
                            class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white font-bold py-3 px-4 rounded-xl shadow transition hover:scale-105">
                            <i class="fas fa-check-double"></i> Mark as Completed
                        </button>
                        {{/if_eq}}
                        <button onclick="openRejectModal()"
                            class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold py-3 px-4 rounded-xl shadow transition hover:scale-105">
                            <i class="fas fa-times-circle"></i> Reject Request
                        </button>
                    </div>
                </div>
                {{/unless_eq}}
                {{/unless_eq}}

                <!-- Status Timeline -->
                <div class="anim-up d2 bg-white rounded-2xl shadow-md p-6">
                    <h3 class="text-gray-800 font-black text-sm uppercase tracking-wide mb-4 flex items-center gap-2">
                        <i class="fas fa-stream text-emerald-600"></i> Status Timeline
                    </h3>
                    <ol class="relative border-l-2 border-gray-200 ml-3 space-y-4">
                        <li class="ml-4">
                            <div class="absolute -left-2 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white"></div>
                            <p class="text-xs font-bold text-emerald-700">Submitted</p>
                            <p class="text-xs text-gray-400">{{formatDate request.createdAt}}</p>
                        </li>
                        <li class="ml-4">
                            <div class="absolute -left-2 w-4 h-4 rounded-full {{#if_eq request.status 'pending'}}bg-gray-300{{else}}bg-blue-500{{/if_eq}} border-2 border-white"></div>
                            <p class="text-xs font-bold {{#if_eq request.status 'pending'}}text-gray-400{{else}}text-blue-700{{/if_eq}}">Processing</p>
                        </li>
                        <li class="ml-4">
                            <div class="absolute -left-2 w-4 h-4 rounded-full {{#switch request.status}}{{#case 'ready'}}bg-emerald-500{{/case}}{{#case 'completed'}}bg-emerald-500{{/case}}{{/switch}} {{#if_eq request.status 'pending'}}bg-gray-300{{/if_eq}}{{#if_eq request.status 'processing'}}bg-gray-300{{/if_eq}}{{#if_eq request.status 'rejected'}}bg-gray-300{{/if_eq}} border-2 border-white"></div>
                            <p class="text-xs font-bold {{#switch request.status}}{{#case 'ready'}}text-emerald-700{{/case}}{{#case 'completed'}}text-emerald-700{{/case}}{{/switch}}{{#if_eq request.status 'pending'}}text-gray-400{{/if_eq}}{{#if_eq request.status 'processing'}}text-gray-400{{/if_eq}}{{#if_eq request.status 'rejected'}}text-gray-400{{/if_eq}}">Ready for Pickup</p>
                        </li>
                        <li class="ml-4">
                            <div class="absolute -left-2 w-4 h-4 rounded-full {{#if_eq request.status 'completed'}}bg-teal-500{{else}}bg-gray-300{{/if_eq}} border-2 border-white"></div>
                            <p class="text-xs font-bold {{#if_eq request.status 'completed'}}text-teal-700{{else}}text-gray-400{{/if_eq}}">Completed</p>
                            {{#if request.completedAt}}<p class="text-xs text-gray-400">{{formatDate request.completedAt}}</p>{{/if}}
                        </li>
                        {{#if_eq request.status 'rejected'}}
                        <li class="ml-4">
                            <div class="absolute -left-2 w-4 h-4 rounded-full bg-red-500 border-2 border-white"></div>
                            <p class="text-xs font-bold text-red-700">Rejected</p>
                        </li>
                        {{/if_eq}}
                    </ol>
                </div>

                <!-- Quick Info -->
                <div class="anim-up d3 bg-emerald-50 border border-emerald-200 rounded-2xl p-5 text-sm space-y-2">
                    <p class="font-bold text-emerald-800 flex items-center gap-2 mb-3">
                        <i class="fas fa-info-circle"></i> Quick Info
                    </p>
                    <div class="flex justify-between text-gray-600">
                        <span>Processing time</span>
                        <span class="font-bold text-gray-800">6 working days</span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Pickup required</span>
                        <span class="font-bold text-gray-800">Yes</span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Copies requested</span>
                        <span class="font-bold text-gray-800">{{request.quantity}}</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Status Update Modal -->
    <div id="statusModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full">
            <h2 class="text-xl font-black text-gray-900 mb-1 flex items-center gap-2">
                <i class="fas fa-tasks text-emerald-600"></i> Update Status
            </h2>
            <p class="text-gray-500 text-sm mb-6">Add optional notes for the student.</p>
            <form method="POST" action="{{basePath}}/requests/{{request.id}}/status" class="space-y-4">
                <input type="hidden" id="statusInput" name="status" value="">
                <div>
                    <label class="block text-gray-700 font-bold text-sm mb-2">Additional Notes <span class="text-gray-400 font-normal">(optional)</span></label>
                    <textarea name="notes" rows="4" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm resize-none" placeholder="Add any notes about this status update..."></textarea>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeStatusModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition">Cancel</button>
                    <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition">
                        <i class="fas fa-check mr-1"></i> Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reject Modal -->
    <div id="rejectModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full">
            <h2 class="text-xl font-black text-gray-900 mb-1 flex items-center gap-2">
                <i class="fas fa-times-circle text-red-600"></i> Reject Request
            </h2>
            <p class="text-gray-500 text-sm mb-6">Please provide a reason. The student will be notified.</p>
            <form method="POST" action="{{basePath}}/requests/{{request.id}}/status" class="space-y-4">
                <input type="hidden" name="status" value="rejected">
                <div>
                    <label class="block text-gray-700 font-bold text-sm mb-2">Rejection Reason <span class="text-red-500">*</span></label>
                    <textarea name="rejectionReason" rows="4" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-red-500 text-sm resize-none" placeholder="Explain why this request is being rejected..."></textarea>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeRejectModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition">Cancel</button>
                    <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-xl transition">
                        <i class="fas fa-times mr-1"></i> Reject
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openStatusModal(status) {
            document.getElementById('statusInput').value = status;
            document.getElementById('statusModal').classList.remove('hidden');
        }
        function closeStatusModal() {
            document.getElementById('statusModal').classList.add('hidden');
        }
        function openRejectModal() {
            document.getElementById('rejectModal').classList.remove('hidden');
        }
        function closeRejectModal() {
            document.getElementById('rejectModal').classList.add('hidden');
        }
        document.getElementById('statusModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeStatusModal(); });
        document.getElementById('rejectModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeRejectModal(); });
    </script>

    {{>footer}}
</body>
</html>
