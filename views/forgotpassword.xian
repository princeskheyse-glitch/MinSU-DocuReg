<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#047857">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DocuReg">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/logo/minsu-logo.png">
  <link rel="icon" type="image/png" href="/images/logo/minsu-logo.png">
  <title>Forgot Password — MinSU DocuReg</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes fadeInUp   { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
    @keyframes float      { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    @keyframes blob       { 0%,100%{border-radius:60% 40% 30% 70%/60% 30% 70% 40%} 50%{border-radius:30% 60% 70% 40%/50% 60% 30% 60%} }
    .anim-up   { animation:fadeInUp .6s ease-out both; }
    .anim-float{ animation:float 3.5s ease-in-out infinite; }
    .blob      { animation:blob 8s ease-in-out infinite; }
    .input-field { transition:border-color .25s,box-shadow .25s,transform .25s; }
    .input-field:focus { transform:translateY(-2px); box-shadow:0 8px 20px rgba(5,150,105,.18); }
    .btn-glow:hover { box-shadow:0 12px 30px rgba(5,150,105,.4); transform:scale(1.03); }
    .btn-glow { transition:all .25s ease; }
  </style>
  <script>if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));}</script></head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden bg-gradient-to-br from-emerald-50 via-green-50 to-teal-100 py-10">

  <div class="absolute top-10 left-10 w-72 h-72 bg-emerald-200 opacity-40 blob pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-64 h-64 bg-teal-200 opacity-40 blob pointer-events-none" style="animation-delay:4s"></div>

  <div class="relative w-full max-w-md px-4 anim-up">

    <!-- Back to Home -->
    <a href="/" class="inline-flex items-center gap-2 text-emerald-700 hover:text-emerald-900 font-semibold text-sm mb-5 group transition">
      <span class="w-7 h-7 rounded-full bg-white shadow flex items-center justify-center group-hover:bg-emerald-50 transition">
        <i class="fas fa-arrow-left text-xs text-emerald-600"></i>
      </span>
      Back to Home
    </a>

    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-emerald-100">

      <!-- Header -->
      <div class="relative bg-gradient-to-br from-emerald-600 via-green-600 to-teal-600 px-8 py-10 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-4 right-4 w-24 h-24 border-2 border-white rounded-full"></div>
          <div class="absolute bottom-4 left-4 w-16 h-16 border-2 border-white rounded-full"></div>
        </div>
        <div class="relative anim-float mb-4">
          <div class="w-24 h-24 rounded-full bg-white mx-auto flex items-center justify-center shadow-2xl overflow-hidden">
            <img src="/images/logo/minsu-logo.png" alt="MinSU Logo" class="w-20 h-20 object-contain">
          </div>
        </div>
        <h1 class="text-white text-3xl font-black relative">Reset Password</h1>
        <p class="text-emerald-100 text-sm mt-1 relative">Enter your email to reset your password</p>
      </div>

      <!-- Form -->
      <div class="px-8 py-8">

        {{#if error}}
        <div class="mb-5 flex items-center gap-3 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
          <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-exclamation-circle text-red-500 text-sm"></i>
          </div>
          <p class="text-red-600 text-sm font-medium">{{error}}</p>
        </div>
        {{/if}}

        {{#if success}}
        <div class="mb-5 flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">
          <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-check-circle text-emerald-500 text-sm"></i>
          </div>
          <p class="text-emerald-700 text-sm font-medium">{{success}}</p>
        </div>
        {{/if}}

        <form method="POST" action="/forgot-password" class="space-y-4">
          <div>
            <label for="email" class="block text-gray-700 font-bold text-sm mb-2">Email Address</label>
            <div class="relative group">
              <i class="fas fa-envelope absolute left-4 top-3.5 text-gray-400 group-focus-within:text-emerald-500 transition-colors text-sm"></i>
              <input type="email" id="email" name="email" required placeholder="your@email.com"
                class="input-field w-full pl-11 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm bg-gray-50 focus:bg-white">
            </div>
          </div>

          <div>
            <label for="newPassword" class="block text-gray-700 font-bold text-sm mb-2">New Password</label>
            <div class="relative group">
              <i class="fas fa-lock absolute left-4 top-3.5 text-gray-400 group-focus-within:text-emerald-500 transition-colors text-sm"></i>
              <input type="password" id="newPassword" name="newPassword" required placeholder="••••••••" minlength="6"
                class="input-field w-full pl-11 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm bg-gray-50 focus:bg-white">
            </div>
          </div>

          <div>
            <label for="confirmPassword" class="block text-gray-700 font-bold text-sm mb-2">Confirm New Password</label>
            <div class="relative group">
              <i class="fas fa-lock absolute left-4 top-3.5 text-gray-400 group-focus-within:text-emerald-500 transition-colors text-sm"></i>
              <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="••••••••" minlength="6"
                class="input-field w-full pl-11 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-emerald-500 text-sm bg-gray-50 focus:bg-white">
            </div>
            <p class="text-gray-400 text-xs mt-1.5 flex items-center"><i class="fas fa-info-circle mr-1 text-emerald-400"></i>Minimum 6 characters</p>
          </div>

          <button type="submit"
            class="btn-glow w-full bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold py-3.5 rounded-xl shadow-lg mt-2 flex items-center justify-center gap-2">
            <i class="fas fa-key"></i>
            <span>Reset Password</span>
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-gray-100 text-center text-sm space-y-2">
          <p class="text-gray-500">Remember your password?
            <a href="/login" class="text-emerald-600 font-bold hover:text-emerald-700 hover:underline transition">Sign in here</a>
          </p>
        </div>
      </div>
    </div>

    <p class="text-center text-gray-400 text-xs mt-6">&copy; 2025 Mindoro State University</p>
  </div>
</body>
</html>
